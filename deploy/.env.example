# RealAmadeus V2 — amadeus-server settings
#
# Copy to `.env` (next to the server, or point AMADEUS_ENV_FILE at it) and fill in what you use.
# NEVER commit the real .env or the Google service-account JSON.
# `.env` にコピーして使ってください。本物の .env やサービスアカウント JSON はコミットしないこと。
#
# This is the complete list of settings (`amadeus-server --help`). Every AMADEUS_* variable can
# also be given as a command-line flag; real environment variables take precedence over this
# file, and an empty value means "use the default".
# これが設定項目のすべてです。AMADEUS_* は同名のコマンドラインオプションでも指定できます。

# --- Server-side credentials / サーバー側の認証情報 -----------------------------------------
# Only FreeAPI (and Vertex AI requests without the user's own credential) use these. OpenAI,
# Claude, Gemini, Groq, OpenRouter and Ollama use the key each user enters in the app.
# FreeAPI（と利用者が認証情報を入れていない Vertex AI）だけが使います。他は利用者のキーを使用。

# Google AI Studio key; FreeAPI tries AI Studio first (GEMINI_API_KEY is accepted instead).
# V2 has no built-in key (V1 had one hard-coded).
AI_STUDIO_API_KEY=

# Google service-account JSON (a file path): FreeAPI's Vertex AI fallback and the Vertex AI
# provider when the request carries no credential. V1 kept this file in the app directory.
# FreeAPI の Vertex AI フォールバック用サービスアカウント JSON のパス。
# AMADEUS_VERTEX_CREDENTIALS=/etc/realamadeus/vertex-service-account.json

# --- Server (defaults shown) / サーバー設定（値は既定値） -----------------------------------
# Listen address. Use 0.0.0.0:9502 only behind a firewall or in a container.
# AMADEUS_BIND=127.0.0.1:9502

# URL prefix; must match the Trunk public_url the frontend was built with (/amadeus/).
# `/` serves the app at the origin root.
# AMADEUS_BASE_PATH=/amadeus

# Directory with the built frontend (index.html, *.wasm, resources/, static/).
# AMADEUS_DIST_DIR=./dist

# Writable directory for the chat log, request counter and rate-limit state
# (.amadeus_chat_log.jsonl, .amadeus_request_count — same files as V1).
# AMADEUS_DATA_DIR=./data

# (Set this one in the real environment — it names the file you are reading.)
# AMADEUS_ENV_FILE=.env

# Serve Trunk's content-hashed .js/.wasm/.css as long-lived `immutable` (V1 sent no-store).
# AMADEUS_IMMUTABLE_ASSETS=true

# Global FreeAPI cap (V1 had it fixed at 65000): FreeAPI requests (provider 8, and requests that
# name no provider, as in V1) are refused once the request counter (.amadeus_request_count in
# AMADEUS_DATA_DIR) reaches it. A positive integer; anything else stops the server at startup.
# The quota endpoint, the cap message and the app's FreeAPI quota display show this value. A
# counter copied from V1 that already reached 65000 keeps FreeAPI off until this is raised.
# FreeAPI 全体のリクエスト上限（V1 は 65000 固定）。カウンターがこの値に達すると停止。正の整数。
# アプリの FreeAPI クォータ表示と上限到達メッセージもこの値になります。
# AMADEUS_FREEAPI_MAX=65000

# --- TTS / STT / RAG proxy / 音声合成・音声認識・RAG の中継 -----------------------------------
# The target URLs are NOT server settings: each request carries the `serverUrl` the user set in
# the app (defaults http://localhost:5100 / 5101 / 5102). The server forwards to that URL, so
# `localhost` means the machine (or container) running amadeus-server.
# 中継先 URL はサーバーの設定ではなく、アプリの設定画面の値がリクエストごとに送られてきます。
# サーバーが中継するため localhost はサーバー側のマシン（コンテナ）を指します。
#
# Restrict which targets may be called (comma separated URL prefixes or `host[:port|:*]`).
# Unset = any URL, like V1. Recommended for public servers. 公開サーバーでは設定を推奨。
# AMADEUS_PROXY_ALLOWLIST=http://localhost:5100,http://localhost:5101,http://localhost:5102

# --- Logging / ログ --------------------------------------------------------------------------
# RUST_LOG=info
