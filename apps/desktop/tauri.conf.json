{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RealAmadeus",
  "mainBinaryName": "RealAmadeus",
  "identifier": "com.dsuv.realamadeus",
  "build": {
    "beforeDevCommand": {
      "script": "trunk serve --port 1420 --public-url / --dist dist-desktop-dev",
      "cwd": "../web",
      "wait": false
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "trunk build --release --public-url / --dist dist-desktop",
      "cwd": "../web"
    },
    "frontendDist": "../web/dist-desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Amadeus",
        "url": "app",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "img-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "DSUV / Elvelt",
    "copyright": "DSUV / Elvelt — Steins;Gate 0 fan project (non-commercial, CC BY-NC 4.0)",
    "category": "Entertainment",
    "shortDescription": "Amadeus — Steins;Gate 0 fan project",
    "longDescription": "RealAmadeus V2: an Amadeus (Steins;Gate 0) fan project rewritten in Rust. Non-commercial, developed under the Nitroplus fan-fiction guidelines.",
    "homepage": "https://dsuv.elvelt.com/amadeus",
    "license": "CC-BY-NC-4.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese",
          "English"
        ],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "games",
        "desktopTemplate": "linux/RealAmadeus.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/RealAmadeus.desktop"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
